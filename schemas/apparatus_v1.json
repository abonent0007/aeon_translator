{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeon.local/schemas/apparatus_v1.json",
  "title": "AEON apparatus criticus (variant readings, шаг 3.5)",
  "type": "object",
  "required": ["work", "apparatus_version", "editions", "loci"],
  "properties": {
    "work": {"type": "string", "minLength": 1, "description": "напр. 'Sappho fr. 31'"},
    "apparatus_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "editions": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
      "description": "все издания, цитируемые в loci; unknown edition → ApparatusError"
    },
    "loci": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line", "readings"],
        "properties": {
          "line": {"type": ["integer", "string"]},
          "context": {
            "type": "string",
            "description": "СОХРАНИВШИЙСЯ контекст вокруг locus; НЕ включает сам locus"
          },
          "readings": {
            "type": "array", "minItems": 2,
            "description": "contest: минимум 2 чтения (одиночное → ApparatusError)",
            "items": {
              "type": "object",
              "required": ["text", "editions"],
              "properties": {
                "text": {"type": "string", "minLength": 1},
                "editions": {
                  "type": "array", "minItems": 1, "items": {"type": "string"},
                  "description": "ATTRIBUTION ОБЯЗАТЕЛЕН: ≥1 издание из apparatus.editions"
                }
              }
            }
          }
        }
      }
    }
  }
}
