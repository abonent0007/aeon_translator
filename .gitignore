# .gitignore — AEON v3.0
# Files NOT uploaded to GitHub (contains keys, models, temp data)

# API keys — NEVER commit
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Models (downloaded at runtime)
*.safetensors
*.onnx
*.bin
models/

# Audio temp files
*.mp3
*.wav
aeon_voice_*
aeon_tts_*

# Image temp files
aeon_flux_*
*.png

# .aeon output files (examples/ сохраняются в репозитории)
*.aeon
!examples/*.aeon
!examples/**/*.aeon
!tests/fixtures/**/*.aeon

# Test / tooling artifacts
.pytest_cache/
.coverage
htmlcov/
*.db

# Offline dumps (данные не коммитим; README-инструкции — в репо)
data/*.zip
data/*.json
data/*.jsonl
data/*.csv
data/pleiades/*
data/trismegistos/*
!data/pleiades/README.md
!data/trismegistos/README.md

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
