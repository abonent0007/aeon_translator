# ═══════════════════════════════════════════════════════════════
# LOGOS Semantic Analysis — пример окружения.
# Скопируйте в .env и заполните своими ключами.
# .env игнорируется git — реальные ключи НЕ коммитить.
# ═══════════════════════════════════════════════════════════════

# ── LLM (DeepSeek) ──
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# AEON_LLM_MODEL=deepseek-chat                # опционально: приоритет над DEEPSEEK_MODEL
# AEON_LLM_BASE_URL=https://api.deepseek.com
# AEON_LLM_MAX_ATTEMPTS=3                    # ретраи: только 5xx/408/429/timeout
# AEON_LLM_RETRY_BACKOFF_BASE=0.5            # экспоненциальный backoff, сек
# AEON_LLM_TIMEOUT_SEC=60.0

# ── Изображения (Flux) ──
FLUX_API_KEY=your_flux_key_here

# ── Эмбеддинги (pluggable; дефолт = текущая модель v3.0) ──
# AEON_EMBEDDING_MODEL=multilingual_mini      # multilingual_mini | labse | ...

# ── Verification 2.0 — пороги по агентам (Фаза 1.3) ──
# AEON_ABSTENTION_THRESHOLD=0.50              # ниже — «Я не знаю»
# AEON_DETECTIVE_MIN_CONFIDENCE=0.85
# AEON_DETECTIVE_REQUIRE_QUOTE=true
# AEON_EXPERT_MIN_CONFIDENCE=0.75
# AEON_EXPERT_MIN_SOURCES=2
# AEON_LOGICIAN_MIN_COHERENCE=0.60
# AEON_LOGICIAN_MAX_CONTRADICTIONS=0

# ── Legacy-пороги v3.0 (сохранены 1:1; менять осторожно) ──
# AEON_LEGACY_CROSS_LINGUAL_THRESHOLD=0.65
# AEON_LEGACY_RISK_VERIFIED_MAX=0.15
# AEON_LEGACY_RISK_MINOR_MAX=0.35
# AEON_LEGACY_RISK_SUSPECT_MAX=0.60
# AEON_SIM_DEEP=0.85
# AEON_SIM_GOOD=0.65
# AEON_SIM_PARTIAL=0.45

# ── Entity Linking / Wikidata (Фаза 1.1; по умолчанию выключено) ──
# AEON_ENTITY_LINKING=1
# AEON_CONTACT_EMAIL=you@example.com          # обязателен в User-Agent Wikidata
# AEON_WIKIDATA_RATE_LIMIT_SEC=1.0
# AEON_WIKIDATA_CACHE_TTL_DAYS=7
# AEON_WIKIDATA_TIMEOUT_SEC=10.0
# AEON_WIKIDATA_MAX_ATTEMPTS=3
# AEON_WIKIDATA_OFFLINE=0                     # 1 = только кэш, без сети
# AEON_MAX_LINKS_PER_ATOM=5
# AEON_WIKIDATA_CACHE_PATH=cache/wikidata.db
# AEON_SCORE_WEIGHT_TYPE=0.40                  # веса скоринга кандидатов
# AEON_SCORE_WEIGHT_EXACTNESS=0.35
# AEON_SCORE_WEIGHT_LANGUAGE=0.15
# AEON_SCORE_WEIGHT_DESCRIPTION=0.10

# ── Логирование ──
# AEON_LOG_FILE=logs/aeon.jsonl
# AEON_LOG_LEVEL=INFO
