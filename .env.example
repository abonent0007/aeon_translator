# ═══════════════════════════════════════════════════════════════
# AEON v4.0 — пример окружения.
# Скопируйте в .env и заполните своими ключами.
# .env игнорируется git — реальные ключи НЕ коммитить.
# ═══════════════════════════════════════════════════════════════

# ── LLM (DeepSeek) ──
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Изображения (Flux) ──
FLUX_API_KEY=your_flux_key_here

# ── Эмбеддинги (pluggable, Фаза 0.3) ──
# AEON_EMBEDDING_MODEL=multilingual_mini      # multilingual_mini | labse | ...

# ── Verification 2.0 (Фаза 1.3) — пороги по агентам ──
# AEON_ABSTENTION_THRESHOLD=0.50
# AEON_DETECTIVE_MIN_CONFIDENCE=0.85
# AEON_EXPERT_MIN_CONFIDENCE=0.75
# AEON_EXPERT_MIN_SOURCES=2
# AEON_LOGICIAN_MIN_COHERENCE=0.60
# AEON_LOGICIAN_MAX_CONTRADICTIONS=0

# ── Entity Linking / Wikidata (Фаза 1.1) ──
# AEON_ENTITY_LINKING=1
# AEON_CONTACT_EMAIL=you@example.com          # обязателен в User-Agent Wikidata
# AEON_WIKIDATA_RATE_LIMIT_SEC=1.0
# AEON_WIKIDATA_CACHE_TTL_DAYS=7
